# ── Base de datos Turso ───────────────────────────────────────────────────────
# URL de tu base de datos Turso (local o remota)
# Para desarrollo local con SQLite embebido:
#   TURSO_DATABASE_URL=file:./local.db
# Para Turso remoto:
#   TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_DATABASE_URL=file:./local.db

# Token de autenticación de Turso (solo necesario para bases remotas)
TURSO_AUTH_TOKEN=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens JWT. OBLIGATORIA. Cámbiala en producción.
JWT_SECRET=

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL del frontend para permitir peticiones CORS (sin barra final)
# En producción: FRONTEND_URL=https://descartables-yofre.vercel.app
# Varias URLs separadas por coma: FRONTEND_URL=https://app.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Seed (credenciales iniciales) ─────────────────────────────────────────────
# Se usan UNA SOLA VEZ al ejecutar "npm run db:seed".
# Cambiá estas credenciales antes de correr el seed en producción.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@mrtotal.com
SEED_ADMIN_PASSWORD=mrtotal333

SEED_CAJERO_NAME=Cajero Yofre
SEED_CAJERO_EMAIL=cajero@yofre.com
SEED_CAJERO_PASSWORD=

SEED_CREADOR_EMAIL=creador@yofre.com
SEED_CREADOR_PASSWORD=
