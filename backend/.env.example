# Base de datos Turso/libSQL
TURSO_DATABASE_URL=libsql://mi-base-de-datos.turso.io
TURSO_AUTH_TOKEN=reemplazar_con_el_token_de_turso

# Usar un valor aleatorio largo. No reutilizar contraseñas de usuarios.
JWT_SECRET=reemplazar_con_un_secreto_aleatorio_largo

# Origenes autorizados, separados por coma y sin rutas.
# En Vercel debe contener el dominio publico del proyecto frontend.
FRONTEND_URL=https://mi-frontend.vercel.app

# Solo para desarrollo local; Vercel define PORT automaticamente.
PORT=3001

# Variables opcionales utilizadas unicamente por `pnpm db:seed`.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@ejemplo.com
SEED_ADMIN_PASSWORD=reemplazar_con_una_contraseña_segura
SEED_CREADOR_EMAIL=creador@ejemplo.com
SEED_CREADOR_PASSWORD=reemplazar_con_una_contraseña_segura
